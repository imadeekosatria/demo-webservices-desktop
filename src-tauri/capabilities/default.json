{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for Verifikasi Penduduk Desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*/*"
        },
        {
          "url": "https://*/*"
        },
        {
          "url": "https://172.16.160.177:8000/*"
        }
      ]
    }
  ]
}
